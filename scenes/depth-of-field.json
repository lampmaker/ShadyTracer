    {
      "id": "m1",
      "label": "checker",
      "params": {
        "baseColor": {
          "r": 0.85,
          "g": 0.85,
          "b": 0.83
        },
        "metallic": 0,
        "roughness": 0.5,
        "anisotropy": 0,
        "specular": 0.5,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "second": {
          "r": 0.06,
          "g": 0.06,
          "b": 0.06
        },
        "square": 10,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8
      },
      "code": "// The base colour and the second in alternate cubes `square` mm on a side, moving with the object.\nlet q = p_local * S_local / mm(1.0);   // the point in mm, moving with the object\nlet c = floor(q / square);\nlet odd = ((i32(c.x) + i32(c.y) + i32(c.z)) & 1) == 1;\nm.baseColor = select(m.baseColor, second, odd);",
      "ranges": {
        "square": {
          "min": 0.5,
          "max": 1000,
          "step": 0.5
        }
      },
      "lengths": [
        "square"
      ]
    },
    {
      "id": "m4",
      "label": "white",
      "params": {
        "baseColor": {
          "r": 0.85,
          "g": 0.85,
          "b": 0.83
        },
        "metallic": 0,
        "roughness": 1,
        "anisotropy": 0,
        "specular": 0,
