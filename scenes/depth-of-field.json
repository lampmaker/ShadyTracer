  "materials": [
    {
      "id": "m1",
      "label": "checker",
      "params": {
        "baseColor": {
          "r": 0.85,
          "g": 0.85,
          "b": 0.83
        },
        "metallic": 0,
        "roughness": 0.5,
        "anisotropy": 0,
        "specular": 0.5,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "second": {
          "r": 0.06,
          "g": 0.06,
          "b": 0.06
        },
        "square": 10,
        "softness": 0,
        "level": 0,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8,
        "translucency": 0,
        "spreadX": 0,
        "spreadY": 0
      },
      "code": "// The base colour and the second in alternate cubes `square` mm on a side, moving with the object -- drawn as a\n// wave, so the edges can be softened and the squares shrunk to dots. s is +1 or -1 at a cube's centre and 0 where\n// two cubes meet; the second colour is where s is above `level`, blended over `softness` either side of it:\n//   level 0            the checker: softness 0 sharp edges, 1 as soft as the wave itself\n//   level up to 1      round dots of the second colour, shrinking, in alternate squares: on a face through cube\n//                      centres, a dot of radius r mm at level = cos(PI * r / square)\n//   level down to -1   the reverse: dots of the base colour in the other squares\n// A cube's centre is at the object's origin (cos, not sin), so the floor's plane z = 0, and a box whose half-sizes\n// are whole squares, have faces through centres. A flat face half a square off that -- where two cubes meet -- has\n// s = 0 all over and shows no squares: change `square` for that object.\nlet q = p_local * S_local / mm(1.0);   // the point in mm, moving with the object\nlet w = cos(PI * q / square);\nlet s = w.x * w.y * w.z;\nlet e = max(softness, 1e-4);           // smoothstep's two edges must differ\nm.baseColor = mix(m.baseColor, second, smoothstep(level - e, level + e, s));",
      "ranges": {
        "square": {
          "min": 0.5,
          "max": 1000,
          "step": 0.5
        },
        "softness": {
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        "level": {
          "min": -1,
          "max": 1,
          "step": 0.01
        }
      },
      "lengths": [
        "square"
      ]
    },
    {
