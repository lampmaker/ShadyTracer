    {
      "id": "m1",
      "label": "concrete",
      "params": {
        "baseColor": {
          "r": 0.56,
          "g": 0.55,
          "b": 0.52
        },
        "metallic": 0,
        "roughness": 0.9,
        "anisotropy": 0,
        "specular": 0.3,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "stain": {
          "r": 0.42,
          "g": 0.41,
          "b": 0.39
        },
        "stainSize": 300,
        "stainAmount": 0.6,
        "poreSpacing": 10,
        "poreRadius": 0.15,
        "poreShare": 0.3,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8
      },
      "code": "// Stains: four octaves of noise `stainSize` mm across. Pores: in a `poreShare` of the Worley cells\n// `poreSpacing` mm apart, a hole `poreRadius` of a cell across -- darker, and rough.\nlet q = p_local * S_local / mm(1.0);   // the point in mm, moving with the object\nlet st = 0.5 + 0.5 * fbm3(q / stainSize, 11u, 4u, 2.0, 0.5).w;\nlet w = worley3x(q / poreSpacing, 12u);\nlet pore = (1.0 - smoothstep(0.6 * poreRadius, poreRadius, w.x)) * step(1.0 - poreShare, w.z);\nm.baseColor = mix(m.baseColor, stain, stainAmount * smoothstep(0.35, 0.75, st)) * (1.0 - 0.7 * pore);\nm.roughness = mix(m.roughness, 1.0, pore);",
      "ranges": {
        "stainSize": {
          "min": 1,
          "max": 1000,
          "step": 1
        },
        "stainAmount": {
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        "poreSpacing": {
          "min": 0.2,
          "max": 50,
          "step": 0.1
        },
        "poreRadius": {
          "min": 0,
          "max": 0.45,
          "step": 0.01
        },
        "poreShare": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "lengths": [
        "stainSize",
        "poreSpacing"
      ]
    },
    {
      "id": "m4",
      "label": "marble",
      "params": {
        "baseColor": {
          "r": 0.92,
          "g": 0.91,
          "b": 0.88
        },
        "metallic": 0,
        "roughness": 0.08,
        "anisotropy": 0,
        "specular": 0.5,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "vein": {
          "r": 0.25,
          "g": 0.27,
          "b": 0.3
        },
        "size": 200,
        "turbulence": 3,
        "sharpness": 10,
        "veinSpacing": 50,
        "cloud": 0.25,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8
      },
      "code": "// Veins about `veinSpacing` mm apart, bent by five octaves of noise over `size` mm -- the stone's\n// movement -- by `turbulence` spacings; `sharpness` is how thin a vein is, and `cloud` a soft grey\n// between them, as Carrara has.\nlet q = p_local * S_local / mm(1.0)/size;   // the point in mm, moving with the object\nlet nz = fbm3(q  , 3u, 5u, 2.0, 0.5);\nlet v = pow(1.0 - abs(sin(PI * (q.x / veinSpacing + turbulence * nz.w))), sharpness);\nlet cl = 0.5 + 0.5 * fbm3(q / 0.5 , 4u, 3u, 2.0, 0.5).w;\nm.baseColor = mix(mix(m.baseColor, vein, cloud * cl), vein, v);",
      "ranges": {
        "size": {
          "min": 5,
          "max": 2000,
          "step": 5
        },
        "turbulence": {
          "min": 0,
          "max": 5,
          "step": 0.01
        },
        "sharpness": {
          "min": 1,
          "max": 40,
          "step": 0.1
        },
        "veinSpacing": {
          "min": 2,
          "max": 500,
          "step": 1
        },
        "cloud": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "lengths": [
        "veinSpacing",
        "size"
      ]
    },
    {
      "id": "m9",
      "label": "sandstone",
      "params": {
        "baseColor": {
          "r": 0.78,
          "g": 0.63,
          "b": 0.45
        },
        "metallic": 0,
        "roughness": 0.9,
        "anisotropy": 0,
        "specular": 0.3,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "band": {
          "r": 0.6,
          "g": 0.4,
          "b": 0.26
        },
        "layer": 8,
        "warp": 2.5,
        "size": 120,
        "grit": 0.3,
        "gritAmount": 0.1,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8
      },
      "code": "// gnoise3 bending layers laid down along the object's z: a layer every `layer` mm, bent by\n// `warp` layers by noise `size` mm across -- and a grit of sand grains `grit` mm across.\nlet q = p_local * S_local / mm(1.0);   // the point in mm, moving with the object\nlet g = gnoise3(q / size, 2u).w;\nlet b = 0.5 + 0.5 * sin(2.0 * PI * (q.z / layer + warp * g));\nlet sand = 1.0 - gritAmount + 2.0 * gritAmount * (0.5 + 0.5 * vnoise3(q / grit, 9u).w);\nm.baseColor = mix(m.baseColor, band, b * b) * sand;",
      "ranges": {
        "layer": {
          "min": 0.2,
          "max": 100,
          "step": 0.1
        },
        "warp": {
          "min": 0,
          "max": 3,
          "step": 0.01
        },
        "size": {
          "min": 0.5,
          "max": 200,
          "step": 0.5
        },
        "grit": {
          "min": 0.02,
          "max": 5,
          "step": 0.01
        },
        "gritAmount": {
          "min": 0,
          "max": 0.5,
          "step": 0.01
        }
      },
      "lengths": [
        "layer",
        "size",
        "grit"
      ]
    }
