  "blocks": [
    {
      "id": "b3",
      "label": "plane",
      "kind": "object",
      "code": "// The plane z = 0, solid below.\nC = add_new(C, Nplane(p), MATERIAL);",
      "params": {},
      "builtin": "plane@1"
    },
    {
      "id": "b6",
      "label": "Menger sponge",
      "kind": "object",
      "code": "// A Menger sponge \"size\" across, \"iterations\" levels deep (iterations is a compile-time constant: the loop\n// bound has to be known to the compiler). sdMenger's sponge is 2 across, so the point is scaled to it.\nlet s = size * 0.5;\nC = add_new(C, sdMenger(p / s, iterations) * s, MATERIAL);",
      "params": {
        "size": 3,
        "iterations": 4
      },
      "constants": {
        "iterations": "u32"
      },
      "ranges": {
        "size": {
          "min": 0.1,
          "max": 20,
          "step": 0.01
        },
        "iterations": {
          "min": 1,
          "max": 6,
          "step": 1
        }
      },
      "lengths": [
        "size"
      ]
    },
    {
      "id": "b8",
      "label": "repeat",
      "kind": "group",
      "code": "// Repeat: copies \"spacing\" apart, \"count\" each way along each axis (0: not along it),\n// so 2 count + 1 per axis -- all for the price of one, which makes it the cheapest\n// thing here. The children must fit in one cell, half a spacing around this group's\n// origin, or the distance is wrong near the cell borders.\np = p - spacing * clamp(round(p / spacing), -count, count);\nC = children(C, p);",
      "params": {
        "spacing": {
          "x": 2,
          "y": 2,
          "z": 2
        },
        "count": {
          "x": 2,
          "y": 2,
          "z": 0
        }
      },
      "lengths": [
        "spacing"
      ],
      "builtin": "repeat@1"
    },
    {
      "id": "b11",
      "label": "cylinder",
      "kind": "object",
      "code": "// A cylinder along z, centred on this node's origin.\nC = add_new(C, Ncylinder(p, height * 0.5, radius), MATERIAL);",
      "params": {
        "radius": 0.5,
        "height": 1
      },
      "ranges": {
        "radius": {
          "min": 0.01,
          "max": 10,
          "step": 0.01
        },
        "height": {
          "min": 0.01,
          "max": 10,
          "step": 0.01
        }
      },
      "lengths": [
        "radius",
        "height"
      ],
      "builtin": "cylinder@1"
    }
  ],
