    {
      "id": "m1",
      "label": "wood",
      "params": {
        "baseColor": {
          "r": 0.72,
          "g": 0.52,
          "b": 0.32
        },
        "metallic": 0,
        "roughness": 0.55,
        "anisotropy": 0,
        "specular": 0.45,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "latewood": {
          "r": 0.42,
          "g": 0.25,
          "b": 0.12
        },
        "ring": 3,
        "lateShare": 0.35,
        "wobble": 0.4,
        "wobbleSize": 60,
        "fibre": 0.15,
        "fibreAmount": 0.12,
        "heart": -150,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8,
        "translucency": 0,
        "spreadX": 0,
        "spreadY": 0
      },
      "code": "// Rings about an axis along the object's z -- the heart of the log, `heart` mm along x from the\n// object's origin, so a board cut beside it shows arcs on its face and stripes on its edges --\n// one every `ring` mm: the base colour (earlywood) darkening into latewood over the last\n// `lateShare` of each, then starting again, as a year does. Gradient noise `wobbleSize` mm across\n// (longer along z) bends them by `wobble` rings; fibres `fibre` mm wide and twenty times as long\n// run along z.\nlet q = p_local * S_local / mm(1.0);   // the point in mm, moving with the object\nlet bend = gnoise3(q / vec3<f32>(wobbleSize, wobbleSize, 4.0 * wobbleSize), 7u).w;\nlet r = fract(length(q.xy - vec2<f32>(heart, 0.0)) / ring + wobble * bend);\nlet late = smoothstep(1.0 - lateShare, 1.0, r);\nlet fib = 0.5 + 0.5 * vnoise3(q / vec3<f32>(fibre, fibre, 20.0 * fibre), 8u).w;\nm.baseColor = mix(m.baseColor, latewood, late) * (1.0 - fibreAmount + 2.0 * fibreAmount * fib);\nm.roughness = min(1.0, m.roughness + 0.15 * late);",
      "ranges": {
        "ring": {
          "min": 0.3,
          "max": 30,
          "step": 0.1
        },
        "lateShare": {
          "min": 0.05,
          "max": 0.95,
          "step": 0.01
        },
        "wobble": {
          "min": 0,
          "max": 3,
          "step": 0.01
        },
        "wobbleSize": {
          "min": 1,
          "max": 200,
          "step": 0.5
        },
        "fibre": {
          "min": 0.02,
          "max": 2,
          "step": 0.01
        },
        "fibreAmount": {
          "min": 0,
          "max": 0.5,
          "step": 0.01
        },
        "heart": {
          "min": -1000,
          "max": 1000,
          "step": 1
        }
      },
      "lengths": [
        "ring",
        "wobbleSize",
        "fibre",
        "heart"
      ]
    },
    {
      "id": "m5",
