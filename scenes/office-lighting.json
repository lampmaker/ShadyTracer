  "materials": [
    {
      "id": "m1",
      "label": "concrete",
      "params": {
        "baseColor": {
          "r": 0.56,
          "g": 0.55,
          "b": 0.52
        },
        "metallic": 0,
        "roughness": 0.9,
        "anisotropy": 0,
        "specular": 0.3,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "stain": {
          "r": 0.42,
          "g": 0.41,
          "b": 0.39
        },
        "stainSize": 300,
        "stainAmount": 0.6,
        "poreSpacing": 10,
        "poreRadius": 0.15,
        "poreShare": 0.3,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8,
        "haze": 0
      },
      "code": "// Stains: four octaves of noise `stainSize` mm across. Pores: in a `poreShare` of the Worley cells\n// `poreSpacing` mm apart, a hole `poreRadius` of a cell across -- darker, and rough.\nlet q = p_local * S_local / mm(1.0);   // the point in mm, moving with the object\nlet st = 0.5 + 0.5 * fbm3(q / stainSize, 11u, 4u, 2.0, 0.5).w;\nlet w = worley3x(q / poreSpacing, 12u);\nlet pore = (1.0 - smoothstep(0.6 * poreRadius, poreRadius, w.x)) * step(1.0 - poreShare, w.z);\nm.baseColor = mix(m.baseColor, stain, stainAmount * smoothstep(0.35, 0.75, st)) * (1.0 - 0.7 * pore);\nm.roughness = mix(m.roughness, 1.0, pore);",
      "ranges": {
        "stainSize": {
          "min": 1,
          "max": 1000,
          "step": 1
        },
        "stainAmount": {
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        "poreSpacing": {
          "min": 0.2,
          "max": 50,
          "step": 0.1
        },
        "poreRadius": {
          "min": 0,
          "max": 0.45,
          "step": 0.01
        },
        "poreShare": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "lengths": [
        "stainSize",
        "poreSpacing"
      ]
    },
    {
      "id": "m5",
      "label": "white plaster",
      "params": {
        "baseColor": {
          "r": 0.85,
          "g": 0.85,
          "b": 0.83
        },
        "metallic": 0,
        "roughness": 1,
        "anisotropy": 0,
        "specular": 0,
        "specularTint": 0,
        "transmission": 0,
        "ior": 1.5,
        "emissive": {
          "r": 1,
          "g": 1,
          "b": 1
        },
        "emissiveLuminance": 0,
        "abbe": 0,
        "attenuationDistance": 0,
        "coating": 0,
        "coatLow": 0,
        "coatHigh": 1,
        "coatEdge": 600,
        "coatWidth": 20,
        "coatIndex": 1.8,
        "haze": 0
      },
      "code": "// Material code: runs once per hit (cheap), after the fields above are put into m.\n//   m        the Material2 to change -- m.baseColor, m.roughness, m.metallic, m.emissive, ...\n//   p, n     the hit point and surface normal, world space;  C  the Hit\n//   p_local  the hit in the object's own frame, so a pattern moves with the object\n//            (costs one extra SDF evaluation per hit on this material)\n//   your own parameters (+ in the parameters header) by name, e.g. a colour stripe\n// e.g. a checker fixed in the world:\n//   m.baseColor = mix(m.baseColor, VEC3(0.05), step(0.0, sin(p.x * 3.0) * sin(p.y * 3.0) * sin(p.z * 3.0)));\n// e.g. stripes that travel with the object:\n//   m.roughness = step(0.5, fract(p_local.x * 4.0)) * 0.6;\n// e.g. with a number width and a colour stripe added with +:\n//   m.baseColor = mix(m.baseColor, stripe, step(fract(p.x / width), 0.5));\n",
      "relief": {
        "code": "// Noise relief: bumps up to \"amplitude\" mm high and deep, about \"size\" mm across -- four octaves\n// of gradient noise (lib/pathtracer/core/noise.js), in real millimetres on the object. Four noises\n// per march step near the surface. slope is the MEASURED gradient bound (a quarter of the proved\n// one, NZ_GRAD_LIP, and a quarter the steps); the normal is taken by differences.\nlet peak = nzFbmLip(4u, 1.0, 0.5, 1.0);                 // the octaves' amplitudes summed\nlet n = fbm3(q / size, 1u, 4u, 2.0, 0.5);\nh = amplitude * n.w / peak;\nslope = amplitude / size * nzFbmLip(4u, 2.0, 0.5, NZ_GRAD_LIP_MEASURED) / peak;",
        "params": {
          "amplitude": 0.3,
          "size": 25
        },
        "ranges": {
          "amplitude": {
            "min": 0,
            "max": 20,
            "step": 0.01
          },
          "size": {
            "min": 0.1,
            "max": 200,
            "step": 0.1
          }
        },
        "lengths": [
          "amplitude",
          "size"
        ]
      }
    },
