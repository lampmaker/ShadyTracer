      "kind": "object",
      "code": "// A flat rectangle in the xy plane, no thickness (sdf.js Nrectangle), seen from both sides:\n// a planar optics detector, or a ray limiter across a beam, with that material type.\nC = add_new(C, Nrectangle(p, VEC2(width, height) * 0.5), MATERIAL);",
      "params": {
        "width": 1,
        "height": 1
      },
