  "functions": "// Functions: WGSL helpers any code node or material in this scene can call.\n// Compiled once, before the materials and the SDF; errors show here at their own lines.\n// e.g. a gyroid, usable in a code node as  C = add_new(C, sd(gyroid(p, 4.0)), MATERIAL);\n//   fn gyroid(p: VEC3, s: f32) -> f32 {\n//       let q = p * s;\n//       return abs(dot(sin(q), cos(q.zxy))) / s - 0.03;\n//   }\n",
  "liveVisibility": true,
  "blocks": [
    {
      "id": "b15",
      "label": "box",
      "kind": "object",
      "code": "// A box: size is the HALF-size along each axis; the rounding stays inside it.\nC = add_new(C, NboxRounded(p, size, rounding), MATERIAL);",
      "params": {
        "size": {
          "x": 0.5,
          "y": 0.5,
          "z": 0.5
        },
        "rounding": 0.02
      },
      "ranges": {
        "rounding": {
          "min": 0,
          "max": 2,
          "step": 0.005
        }
      },
      "lengths": [
        "size",
        "rounding"
      ],
      "builtin": "box@1"
    },
    {
      "id": "b16",
      "label": "plane",
      "kind": "object",
      "code": "// The plane z = 0, solid below.\nC = add_new(C, Nplane(p), MATERIAL);",
      "params": {},
      "builtin": "plane@1"
    },
    {
      "id": "b17",
      "label": "disc",
      "kind": "object",
      "code": "// A flat disc in the xy plane, no thickness (sdf.js Ndisc), seen from both sides.\nC = add_new(C, Ndisc(p, radius), MATERIAL);",
      "params": {
        "radius": 0.5
      },
      "ranges": {
        "radius": {
          "min": 0.01,
          "max": 10,
          "step": 0.01
        }
      },
      "lengths": [
        "radius"
      ],
      "builtin": "disc@1"
    },
    {
      "id": "b18",
      "label": "lens",
      "kind": "object",
      "code": "// A spherical lens along z (sdf.js Nlens): r1 the +z face, r2 the -z face; a positive radius\n// bulges out, a negative one is hollowed in, 0 is flat. Its refractive index is its material's --\n// give it a glass. Thin lens: 1/f = (n - 1)(1/r1 + 1/r2).\nC = add_new(C, Nlens(p, diameter, thickness, r1, r2), MATERIAL);",
      "params": {
        "diameter": 1,
        "thickness": 0.2,
        "r1": 2,
        "r2": 2
      },
      "ranges": {
        "diameter": {
