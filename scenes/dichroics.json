      "code": "// Material code: runs once per hit, after the fields above are put into m.\n",
      "relief": {
        "code": "// Noise relief: bumps up to \"amplitude\" mm high and deep, about \"size\" mm across -- four octaves\n// of gradient noise (lib/pathtracer/core/noise.js), in real millimetres on the object. Four noises\n// per march step near the surface. slope is the MEASURED gradient bound (a quarter of the proved\n// one, NZ_GRAD_LIP, and a quarter the steps); the normal is taken by differences.\nlet peak = nzFbmLip(4u, 1.0, 0.5, 1.0);                 // the octaves' amplitudes summed\nlet n = fbm3(q / size, 1u, 4u, 2.0, 0.5);\nh = amplitude * n.w / peak;\nslope = amplitude / size * nzFbmLip(4u, 2.0, 0.5, NZ_GRAD_LIP_MEASURED) / peak;",
        "params": {
          "amplitude": 0.49999999999999994,
          "size": 8
        },
        "ranges": {
          "amplitude": {
            "min": 0,
            "max": 20,
            "step": 0.01
          },
          "size": {
            "min": 0.1,
            "max": 200,
            "step": 0.1
          }
        },
        "lengths": [
          "amplitude",
          "size"
        ]
      }
    },
