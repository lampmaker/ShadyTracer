          "min": 0,
          "max": 2,
          "step": 0.005
        }
      },
      "lengths": [
        "size",
        "rounding"
      ],
      "builtin": "box@1"
    },
    {
      "id": "b25",
      "label": "plane",
      "kind": "object",
      "code": "// The plane z = 0, solid below.\nC = add_new(C, Nplane(p), MATERIAL);",
      "params": {},
      "builtin": "plane@1"
    },
    {
      "id": "b83",
      "label": "prism",
      "kind": "object",
      "code": "// A prism along z, centred: a regular polygon of sides sides (3 a triangle, 4 a square, ...), radius to its\n// corners, a flat side down -- extruded. sides is live: dragging it needs no compile. shapes.js Nprism.\nC = add_new(C, Nprism(p, sides, radius, height), MATERIAL);",
      "params": {
        "sides": 3,
        "radius": 0.5,
        "height": 1
      },
      "ranges": {
        "sides": {
          "min": 3,
          "max": 12,
          "step": 1
        },
        "radius": {
          "min": 0.01,
          "max": 10,
          "step": 0.01
        },
        "height": {
          "min": 0.01,
          "max": 10,
          "step": 0.01
        }
      },
      "lengths": [
