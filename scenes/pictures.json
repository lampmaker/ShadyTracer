      "relief": {
        "code": "// Relief from a picture: the picture \"heights\" as a height -- its luminance times its alpha -- white \"amplitude\" mm\n// up (raise 1) or engraved as far down (raise -1), black at the surface. Read planar from the object's x and y in mm,\n// at the picture's own size, offset, turn and wrap, on every face; smooth (a cubic B-spline of its pixels: sixteen\n// reads at every march step near the surface). heightAt's second number is the bound on its slope per mm, worked\n// out from the picture's own pixels when it was read, and from its size and wrap: the march never steps through it.\nlet picture_height = heightAt(heights, q);\nh = amplitude * raise * picture_height.x;\nslope = amplitude * abs(raise) * picture_height.y;",
        "params": {
          "amplitude": 3,
          "raise": 1
        },
        "ranges": {
          "amplitude": {
            "min": 0,
            "max": 20,
            "step": 0.01
          },
          "raise": {
            "min": -1,
            "max": 1,
            "step": 0.01
          }
        },
        "lengths": [
          "amplitude"
        ]
      }
    }
