    {
      "id": "b23",
      "label": "pyramid",
      "kind": "object",
      "code": "// A pyramid along z: its base base.x by base.y at z = -height/2, its top top.x by top.y at +height/2 --\n// a top of 0 by 0 is an apex, anything else a frustum (bigger than the base: upside down). shapes.js Nfrustum.\nC = add_new(C, Nfrustum(p, base, top, height), MATERIAL);",
      "params": {
        "base": {
          "x": 1,
          "y": 1
        },
        "top": {
          "x": 0,
          "y": 0
        },
        "height": 1
      },
