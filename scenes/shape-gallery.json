    {
      "id": "b19",
      "label": "cone",
      "kind": "object",
      "code": "// A capped cone along z: base radius at the bottom, top radius at the top.\n// No analytic normal (sdCappedCone): the renderer takes one by differences.\nC = add_new(C, sdCappedCone(p, height * 0.5, base, top), MATERIAL);",
      "params": {
