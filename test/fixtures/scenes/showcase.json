    {
      "id": "b3",
      "label": "Carved box",
      "kind": "object",
      "code": "// a rounded box with a ball smoothly cut out of it -- the old opSmoothSubtract, kept as it was\nvar bx = Nroundedbox(p + VEC3(0.0, 8.0, 0.0), VEC3(2.0, 2.0, 2.0), 0.9);\nbx = opSmoothSubtract(bx, Nsphere(p + VEC3(0.0, 5.0, -2.0), 2.0), 0.05);\nC = add_new(C, bx, MATERIAL);",
      "params": {}
    },
    {
      "id": "b4",
      "label": "Menger sponge",
      "kind": "object",
      "code": "// a Menger sponge with analytic normals; iterations is compile-time, so its loop unrolls\nC = add_new(C, Nmenger(p, iterations), MATERIAL);",
      "params": {
        "iterations": 4
      },
      "constants": {
        "iterations": "u32"
      },
      "ranges": {
        "iterations": {
          "min": 1,
