    {
      "id": "b1",
      "label": "Carved box",
      "kind": "object",
      "code": "// a rounded box with a ball smoothly cut out of it -- the old NopSmoothSubtract, kept as it was\nvar bx = Nroundedbox(p, VEC3(2.0, 2.0, 2.0), 0.9);\nbx = NopSmoothSubtract(bx, Nsphere(p + VEC3(0.0, 3.0, -2.0), 2.0), 0.05);\nC = add_new(C, bx, MATERIAL);",
      "params": {}
    },
    {
      "id": "b2",
      "label": "Ground",
      "kind": "object",
      "code": "C = add_new(C, NboxRounded(p, size, rounding), MATERIAL);",
      "params": {
        "size": {
          "x": 10.01,
          "y": 10.01,
          "z": 0.11
        },
        "rounding": 0.01
      }
    },
    {
      "id": "b3",
      "label": "Blob",
      "kind": "object",
      "code": "// four spheres, smooth-unioned into a blob -- the old NopSmoothUnion, kept as it was\nvar blob = NopSmoothUnion(Nsphere(p, 0.8), Nsphere(p + VEC3(0.0, -1.0, 0.0), 0.5), 0.3);\nblob = NopSmoothUnion(blob, Nsphere(p + VEC3(-1.0, 0.0, 0.0), 0.5), 0.4);\nblob = NopSmoothUnion(blob, Nsphere(p + VEC3(0.0, 0.0, -1.0), 0.5), 0.4);\nC = add_new(C, blob, MATERIAL);",
      "params": {}
    },
